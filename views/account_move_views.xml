<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="account_view_move_form_inherit_l10n_pe_plame" model="ir.ui.view">
        <field name="name">account.view.move.form.inherit.l10n.pe.plame</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="fch_detraccion"
                       invisible = "move_type not in ['in_invoice']"/>
                <field name="constancia_detraccion"
                       invisible = "move_type not in ['in_invoice']"/>
            </xpath>
        </field>
    </record>

</odoo>